# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo
.next/
out/

# Env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Test / coverage
coverage/

# Docker volumes (local data)
.data/
postgres-data/

# Locally-downloaded Prisma engines (sandbox build workaround)
.prisma-engines/

# Playwright
test-results/
playwright-report/
.playwright/

# Attachment uploads (runtime storage; UPLOADS_DIR — maps to a PVC in K8s)
uploads/
apps/api/uploads/
dump.rdb

# QA agents' transient browser-exploration scratch scripts (never deliverables)
apps/web/_qa_*.mjs

# Isolated git worktrees the harness creates for parallel build agents. These
# are ephemeral checkouts of this same repo (auto-removed when the agent ends),
# so committing one would add a whole second copy of the tree to history. The
# rest of .claude/ — agents, skills, workflows — stays tracked.
.claude/worktrees/

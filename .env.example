# ──────────────────────────────────────────────────────────────
# Next Lane — environment configuration
# Copy to .env and adjust as needed. Defaults work for local Docker.
# ──────────────────────────────────────────────────────────────

# Postgres
POSTGRES_USER=nextlane
POSTGRES_PASSWORD=nextlane
POSTGRES_DB=nextlane
POSTGRES_PORT=5432

# API (NestJS)
API_PORT=4000
# Connection string the API uses. Inside docker compose the host is "db".
DATABASE_URL=postgresql://nextlane:nextlane@db:5432/nextlane?schema=public
# For running the API on the host (outside docker) use localhost:
# DATABASE_URL=postgresql://nextlane:nextlane@localhost:5432/nextlane?schema=public

# Auth — REQUIRED. The API refuses to start if JWT_SECRET is unset/empty.
# Generate a strong, unique value (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d

# CORS — comma-separated allowlist of browser origins permitted to call the API
# with credentials. Defaults to the local web app if unset.
CORS_ORIGINS=http://localhost:3000

# Redis (realtime / future queues)
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Web (Vite) — URL the browser uses to reach the API
WEB_PORT=3000
VITE_API_URL=http://localhost:4000

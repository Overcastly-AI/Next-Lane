// Next Lane data model. Single source of truth for the database.
// Changes go through `prisma migrate`. See docs/ARCHITECTURE.md.
//
// Baseline v2 — applied 2026-06-28.
// add_planning_poker — applied 2026-06-28.
// add_standups — applied 2026-06-28.
// add_personal_boards — applied 2026-06-28.
// add_automation_engine — applied 2026-06-28.
// add_activitylog_status_index — applied 2026-06-28.
// add_workspace_branding — applied 2026-06-28.
// add_configurable_workflows — applied 2026-06-28.
// add_per_board_workflows — applied 2026-06-29.
// add_time_tracking — applied 2026-06-29.
// add_issue_templates — applied 2026-06-29.
// add_github_integration — applied 2026-07-02.
// add_dashboards — applied 2026-07-02.
// add_instance_admin_oidc_config — applied 2026-07-02.
// add_project_membership — applied 2026-07-02.
// add_pages — applied 2026-07-09.
// Deferred to feature slices (do not add here without a feature branch):
//   - pgvector embedding column (Phase 6)
//   - GitLab / Gitea connections, auto-link-on-PR-open (Phase 9 follow-up)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum IssueType {
  TASK
  BUG
  STORY
  EPIC
  SUBTASK
}

enum Priority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

enum StatusCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum SprintState {
  PLANNED
  ACTIVE
  COMPLETED
}

enum BoardType {
  KANBAN
  SCRUM
}

/// How a DashboardGadget renders its NLQL query result.
/// STAT = single count; TABLE = compact issue list; BREAKDOWN = counts
/// grouped by a field; BURNDOWN = sprint burndown scoped to the query's sprint;
/// VELOCITY_TREND = committed vs completed points over the project's last N
/// sprints (project-wide — the gadget's NLQL query isn't used to scope it).
enum DashboardGadgetVisualization {
  STAT
  TABLE
  BREAKDOWN
  BURNDOWN
  VELOCITY_TREND
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

/// SSO/OIDC Phase 2 — the kind of identity provider a multi-provider
/// `SsoProvider` row represents. `OIDC` reuses the same discovery/token-
/// exchange flow as the Phase-1 `OidcConfig` singleton (just parameterized
/// per-row instead of a single effective config); `SAML` is the new
/// SP-initiated SAML 2.0 assertion-consumer-service flow (`@node-saml/node-saml`).
enum SsoProviderType {
  OIDC
  SAML
}

enum NotificationType {
  ASSIGNED
  MENTIONED
  COMMENTED
  WATCHED_UPDATED
}

enum CustomFieldType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  DATE
  CHECKBOX
  URL
}

enum IssueLinkType {
  BLOCKS
  BLOCKED_BY
  RELATES_TO
  DUPLICATES
  DUPLICATED_BY
  CLONES
}

enum VersionState {
  UNRELEASED
  RELEASED
  ARCHIVED
}

/// Lifecycle state of a planning poker session.
/// VOTING   — cards are hidden; participants submit their estimates.
/// REVEALED — facilitator flips all cards; discussion phase.
/// CLOSED   — session is finished; final estimates have been committed.
enum PokerState {
  VOTING
  REVEALED
  CLOSED
}

/// The event that triggers an AutomationRule evaluation.
/// ISSUE_CREATED      — a new issue was opened in the project.
/// ISSUE_UPDATED      — any field on an existing issue changed.
/// ISSUE_TRANSITIONED — the issue's status moved (subset of UPDATED, but
///                      surfaced separately because transition-based rules
///                      are the most common automation pattern).
/// ISSUE_COMMENTED    — a comment was posted on the issue.
enum AutomationTrigger {
  ISSUE_CREATED
  ISSUE_UPDATED
  ISSUE_TRANSITIONED
  ISSUE_COMMENTED
}

/// The outcome of a single AutomationRule run.
/// SUCCESS — all actions executed without error.
/// SKIPPED — the NLQL condition evaluated to false (no actions were run).
/// FAILED  — one or more actions threw an error; see AutomationRun.error.
enum AutomationRunStatus {
  SUCCESS
  SKIPPED
  FAILED
}

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  passwordHash       String
  avatarColor        String   @default("#6366f1")
  emailNotifications Boolean  @default(true)
  /// Instance-level admin flag — gates instance-wide settings (e.g. the
  /// in-app SSO/OIDC configuration screen) that are distinct from
  /// workspace-level `Membership.role: ADMIN`. Defaults to true for the
  /// very first user created on a fresh install (see `AuthService.register`'s
  /// isFirstUser check); already-provisioned installs are backfilled to the
  /// oldest existing user by the migration that adds this column.
  isInstanceAdmin    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships    Membership[]
  reportedIssues Issue[]       @relation("reporter")
  assignedIssues Issue[]       @relation("assignee")
  comments       Comment[]
  activities     ActivityLog[]
  watching       Watcher[]

  // Notifications addressed to this user (recipient) and ones this user caused.
  notifications        Notification[]        @relation("recipient")
  actedNotifications   Notification[]        @relation("actor")
  passwordResetTokens  PasswordResetToken[]
  apiTokens            ApiToken[]
  attachments          Attachment[]
  auditEvents          AuditEvent[]
  shareTokens          ShareToken[]
  dashboardShareTokens DashboardShareToken[]

  // Team memberships
  teamMemberships TeamMember[]

  // Issue links created by this user
  issueLinksCreated IssueLink[]

  // Project lead back-relation
  ledProjects Project[] @relation("projectLead")

  // Component default assignee back-relation
  defaultAssigneeComponents Component[] @relation("componentDefaultAssignee")

  // SavedFilter ownership
  savedFilters SavedFilter[]

  // Planning poker
  pokerSessionsCreated PokerSession[] @relation("pokerCreator")
  pokerVotes           PokerVote[]

  // Async standups
  standupEntries StandupEntry[]

  // Personal boards
  personalColumns PersonalColumn[]
  personalCards   PersonalCard[]

  // Automation engine
  automationRulesCreated AutomationRule[]

  // Time tracking
  workLogs WorkLog[]

  // Issue templates (default assignee back-relation)
  issueTemplatesAsDefaultAssignee IssueTemplate[] @relation("templateDefaultAssignee")

  // Personal quick links (user-defined shortcuts to external apps)
  quickLinks QuickLink[]

  // Per-project role overrides (sparse — most users have none; see ProjectMembership)
  projectMemberships ProjectMembership[]

  // Agent context handoff writes attributed to this user (nullable FK; see ProjectAgentContext)
  agentContextUpdates ProjectAgentContext[]

  // Pages — authorship / attribution (all nullable FKs; SetNull preserves the
  // page/version when the account is later deleted)
  authoredPages      Page[]        @relation("pageAuthor")
  lastEditedPages    Page[]        @relation("pageLastEditedBy")
  editedPageVersions PageVersion[]
}

/// A user-defined shortcut to an external URL (their own apps/tools), shown in
/// the header Quick Links menu. Personal to the user; persists across devices.
model QuickLink {
  id        String   @id @default(cuid())
  userId    String
  label     String
  url       String
  /// Optional hex accent color (e.g. "#2563eb") shown as a dot/left-border.
  color     String?
  /// Optional free-text group name; links sharing a name render under one
  /// collapsible header. Null/empty = ungrouped.
  group     String?
  /// Fractional/integer ordering for display (lower = first).
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Personal API Token (PAT) for scripting / CI access to the REST API.
// Only the SHA-256 hex hash of the raw token is stored — the raw value
// is shown once at creation and never retrievable again.
// Token format on creation: "nlp_" + 32 random bytes base64url.
//
// `scopes` — optional list of scope strings (e.g. "issues:read", "webhooks:write").
// An empty array means "unrestricted" (same as a JWT browser session).
// See PAT_SCOPES in packages/shared for the full vocabulary.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique // SHA-256 hex of the raw "nlp_..." token
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime? // null = active; non-null = revoked
  scopes     String[]  @default([]) // empty = unrestricted (backward-compat)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use time-limited token for password reset.
// Only the SHA-256 hash of the raw token is stored — the raw token is never
// persisted and only travels through the delivery channel (log in dev / SMTP later).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 hex of the raw 32-byte token
  expiresAt DateTime
  usedAt    DateTime? // null = not yet consumed

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  /// Accent color for workspace branding, stored as a #RRGGBB hex string.
  /// Null = use the product default. Validated in the application layer.
  brandColor     String?
  /// On-disk storage key for the uploaded workspace logo image (same scheme as
  /// Attachment.storageKey — a UUID-based path under UPLOADS_DIR set by multer
  /// diskStorage). Null = no custom logo has been uploaded.
  logoStorageKey String?
  /// MIME type of the uploaded logo (e.g. "image/png", "image/svg+xml").
  /// Required by the serve endpoint to set the correct Content-Type header.
  /// Null when no logo has been uploaded (always null when logoStorageKey is null).
  logoMimeType   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships Membership[]
  projects    Project[]
  auditEvents AuditEvent[]
  teams       Team[]

  /// SSO/OIDC Phase 2 — workspaces referenced as a JIT-provisioning default
  /// by one or more `SsoProvider` rows (`onDelete: SetNull` on that side —
  /// deleting a workspace disables JIT auto-provisioning for any provider
  /// pointed at it rather than blocking the delete or cascading).
  ssoJitDefaultFor SsoProvider[]
}

model Membership {
  id          String   @id @default(cuid())
  role        Role     @default(MEMBER)
  userId      String
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

model Project {
  id               String   @id @default(cuid())
  key              String // e.g. "NL"; unique within a workspace
  name             String
  description      String?
  leadId           String?
  workspaceId      String
  archived         Boolean  @default(false)
  issueSeq         Int      @default(0) // last issue number assigned for this project
  /// When false (default) all status transitions are permitted — existing behavior.
  /// When true, only transitions defined in WorkflowTransition are legal; the
  /// service layer enforces this before updating an issue's statusId.
  workflowEnforced Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        User?                 @relation("projectLead", fields: [leadId], references: [id], onDelete: SetNull)
  issues      Issue[]
  statuses    Status[]
  sprints     Sprint[]
  labels      Label[]
  boards      Board[]
  webhooks    WebhookSubscription[]
  shareTokens ShareToken[]

  // Phase 5 entities
  customFieldDefinitions CustomFieldDefinition[]
  savedFilters           SavedFilter[]
  components             Component[]
  versions               Version[]
  notifications          Notification[]

  // Planning poker
  pokerSessions PokerSession[]

  // Async standups
  standupEntries StandupEntry[]

  // Automation engine
  automationRules AutomationRule[]

  // Configurable workflows
  workflowTransitions WorkflowTransition[]

  // Named workflow definitions (per-board workflows)
  workflows Workflow[]

  // Issue templates
  issueTemplates IssueTemplate[]

  // GitHub integration (Phase 9 — Developer Graph, v1 two-way link)
  githubIntegration GithubIntegration?

  // GitLab integration (Phase 9 — Developer Graph, v1 two-way link; same shape as GitHub)
  gitlabIntegration GitlabIntegration?

  // Gitea integration (Phase 9 — Developer Graph, v1 two-way link; HMAC-signed like GitHub)
  giteaIntegration GiteaIntegration?

  // Configurable dashboards (NLQL-native gadget framework)
  dashboards Dashboard[]

  // Per-project role overrides (sparse — absence means "inherit workspace role")
  projectMemberships ProjectMembership[]

  // Agent context (per-project agent handoff memory — one row, optional)
  agentContext ProjectAgentContext?

  // Pages (Confluence-style knowledge base — project-scoped page tree)
  pages Page[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Per-project role override (admin depth — agency/enterprise multi-project access)
// ---------------------------------------------------------------------------

/// An OVERRIDE of a user's effective role on a single project, layered above
/// the workspace-wide `Membership.role`. Sparse by design: the ABSENCE of a
/// row for (projectId, userId) means "inherit the workspace role" — this
/// table is never backfilled for every member, only written when an admin
/// explicitly elevates (e.g. workspace MEMBER -> project ADMIN) or restricts
/// (e.g. workspace MEMBER -> project VIEWER) a user's access to one project.
///
/// Resolution rule (single source of truth: `getEffectiveProjectRole` in
/// `apps/api/src/common/membership.util.ts`):
///   1. The user must have a workspace `Membership` row at all — a stray
///      `ProjectMembership` row never grants access on its own (tenant
///      isolation: project role can only narrow/widen an *existing*
///      workspace relationship, never create one).
///   2. Workspace ADMINs always retain full access — any override row for a
///      workspace ADMIN is ignored when resolving the effective role (and
///      rejected at write time by the service layer), so an override can
///      never accidentally lock out — or be used to redundantly re-grant —
///      an admin.
///   3. Otherwise, an existing `ProjectMembership` row's `role` wins over the
///      workspace `Membership.role` (both elevating and restricting).
///   4. Absent an override, the workspace `Membership.role` applies
///      unchanged — zero behavior change for every project without one.
model ProjectMembership {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Team (workspace-scoped; prerequisite for Phases 5, 7, 10)
// ---------------------------------------------------------------------------

/// A named sub-workspace group of members. Teams are the audience for
/// standups, planning poker sessions, and per-team analytics. A team spans
/// multiple projects (workspace-level, not project-level).
model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  standupEntries StandupEntry[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// Many-to-many: User belongs to zero or more Teams within a Workspace.
model TeamMember {
  teamId String
  userId String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Board
// ---------------------------------------------------------------------------

/// A view of a project's issues. A project can have many boards; each has a
/// `type` (KANBAN = continuous flow; SCRUM = active-sprint focus) that controls
/// how issues are scoped. Boards share the project's statuses (columns). The
/// `filterQuery` (NLQL) and `colorRules` columns are reserved for later slices
/// (saved query filtering + conditional card colors) and are dormant until then.
/// `savedFilterId` optionally links to a persisted SavedFilter (Phase 5).
model Board {
  id             String    @id @default(cuid())
  projectId      String
  name           String
  type           BoardType @default(KANBAN)
  /// NLQL query string applied on top of the board's base scope. Null = no filter.
  filterQuery    String?
  /// Ordered list of conditional color rules: [{ id, query, color, label }].
  /// First match wins. Null/empty = no card coloring.
  colorRules     Json?
  order          Int       @default(0)
  isDefault      Boolean   @default(false)
  savedFilterId  String?
  /// Optional named Workflow this board enforces. Null = use the project-level
  /// legacy workflowEnforced + WorkflowTransition path (backward-compat).
  workflowId     String?
  /// Default swimlane group-by dimension applied when the board loads without
  /// an explicit ?group= URL param. Core dimension key (assignee/priority/
  /// type/epic/component/label/sprint) or `cf:<CustomFieldDefinition.id>`.
  /// Null = flat board (no default grouping).
  defaultGroupBy String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  savedFilter SavedFilter? @relation("boardFilter", fields: [savedFilterId], references: [id], onDelete: SetNull)
  /// Named workflow associated with this board; null = project-level enforcement.
  workflow    Workflow?    @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([workflowId])
}

// ---------------------------------------------------------------------------
// Status, Sprint, Label
// ---------------------------------------------------------------------------

model Status {
  id        String         @id @default(cuid())
  name      String
  category  StatusCategory @default(TODO)
  order     Int            @default(0)
  wipLimit  Int?
  projectId String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  project               Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues                Issue[]
  /// Workflow transitions that originate FROM this status.
  transitionsFrom       WorkflowTransition[] @relation("transitionFromStatus")
  /// Workflow transitions that lead INTO this status.
  transitionsInto       WorkflowTransition[] @relation("transitionToStatus")
  /// GitHub/GitLab integrations that auto-transition a merged PR's/MR's
  /// linked issue(s) to this status. See `GithubIntegration.autoTransitionStatusId`.
  githubAutoTransitions GithubIntegration[]  @relation("githubAutoTransitionStatus")
  gitlabAutoTransitions GitlabIntegration[]  @relation("gitlabAutoTransitionStatus")

  @@index([projectId])
}

model Sprint {
  id          String      @id @default(cuid())
  name        String
  goal        String?
  state       SprintState @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  completedAt DateTime?
  projectId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues        Issue[]
  pokerSessions PokerSession[]

  @@index([projectId])
}

model Label {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#94a3b8")
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueLabel[]

  @@unique([projectId, name])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Phase 5: Custom Fields
// ---------------------------------------------------------------------------

/// Project-scoped definition of a custom field.
/// `appliesToTypes` is empty array = applies to all issue types.
/// `options` is non-null and non-empty only for SELECT / MULTI_SELECT types.
/// `order` controls display order in the issue form.
model CustomFieldDefinition {
  id             String          @id @default(cuid())
  projectId      String
  name           String // display name, e.g. "Severity"
  key            String // snake_case machine key, e.g. "severity"
  type           CustomFieldType
  options        String[]        @default([]) // allowed values for SELECT/MULTI_SELECT
  appliesToTypes IssueType[]     @default([]) // empty = all types
  required       Boolean         @default(false)
  /// When true, the field's value is pinned as a chip on board cards.
  showOnCard     Boolean         @default(false)
  order          Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Phase 5: Saved Filters
// ---------------------------------------------------------------------------

/// A saved NLQL filter. Personal (projectId null) or project-shared.
/// Boards can reference a saved filter rather than duplicating NLQL text.
model SavedFilter {
  id        String   @id @default(cuid())
  ownerId   String // always set — the user who created it
  projectId String? // null = personal/cross-project; non-null = project-shared
  name      String
  query     String // NLQL query text
  isShared  Boolean  @default(false) // visible to all project members when true
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boards  Board[]  @relation("boardFilter")

  @@index([ownerId])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Phase 5: Components and Versions / Releases
// ---------------------------------------------------------------------------

/// Project-scoped sub-area (e.g. "Mobile App", "API", "Database").
/// Has an optional default assignee.
model Component {
  id                String   @id @default(cuid())
  projectId         String
  name              String
  description       String?
  defaultAssigneeId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  defaultAssignee User?           @relation("componentDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  issues          Issue[]
  issueTemplates  IssueTemplate[] @relation("templateComponent")

  @@unique([projectId, name])
  @@index([projectId])
  @@index([defaultAssigneeId])
}

/// Version / Release: tracks what target release an issue is planned for.
model Version {
  id          String       @id @default(cuid())
  projectId   String
  name        String // e.g. "v1.2.0"
  description String?
  state       VersionState @default(UNRELEASED)
  releaseDate DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueVersion[]

  @@unique([projectId, name])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Issue (core)
// ---------------------------------------------------------------------------

model Issue {
  id                      String                   @id @default(cuid())
  number                  Int // per-project sequential number; key = project.key + "-" + number
  projectId               String
  type                    IssueType                @default(TASK)
  title                   String
  description             String?
  statusId                String
  assigneeId              String?
  reporterId              String?
  priority                Priority                 @default(MEDIUM)
  storyPoints             Int?
  parentId                String? // self-relation for epic -> story -> subtask
  // Intended hierarchy: EPIC > STORY / TASK > SUBTASK. Enforced in service layer.
  sprintId                String?
  startDate               DateTime? // optional start date; null = no start date. When both are set, startDate <= dueDate (enforced in service layer).
  dueDate                 DateTime? // optional due date; null = no due date
  rank                    String // fractional index for board/backlog ordering
  // Custom field values as a flat JSONB object keyed by CustomFieldDefinition.id.
  // Queried via jsonb_path_ops GIN index (see baseline migration raw SQL).
  // Example: { "cldefinition_abc": "S1", "cldefinition_xyz": 42 }
  customFields            Json?
  componentId             String?
  /// Original time estimate in minutes; null = not estimated.
  originalEstimateMinutes Int?
  // Generated tsvector for full-text search; managed entirely by Postgres
  // (GENERATED ALWAYS AS ... STORED). Prisma cannot read/write this column
  // directly — all FTS queries go through $queryRaw. The GIN index
  // "Issue_searchVector_idx" is created via raw SQL in the baseline migration.
  searchVector            Unsupported("tsvector")?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status        Status         @relation(fields: [statusId], references: [id])
  assignee      User?          @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter      User?          @relation("reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  parent        Issue?         @relation("subtasks", fields: [parentId], references: [id], onDelete: SetNull)
  children      Issue[]        @relation("subtasks")
  sprint        Sprint?        @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  component     Component?     @relation(fields: [componentId], references: [id], onDelete: SetNull)
  comments      Comment[]
  activities    ActivityLog[]
  labels        IssueLabel[]
  watchers      Watcher[]
  notifications Notification[]
  attachments   Attachment[]

  // Phase 5 relations
  linksFrom IssueLink[]    @relation("linkSource")
  linksTo   IssueLink[]    @relation("linkTarget")
  versions  IssueVersion[]

  // Planning poker
  pokerItems PokerItem[]

  // Async standups — issues referenced as blockers in a standup
  standupBlockerLinks StandupBlockerLink[]

  // Personal boards — cards promoted to this issue
  promotedPersonalCards PersonalCard[]

  // Automation engine — run history for this issue
  automationRuns AutomationRun[]

  // Checklist items
  checklistItems ChecklistItem[]

  // Time tracking
  workLogs WorkLog[]

  // GitHub integration — linked PRs / commits / branches (Phase 9)
  githubLinks IssueGithubLink[]

  // GitLab integration — linked MRs / commits / branches (Phase 9)
  gitlabLinks IssueGitlabLink[]

  // Gitea integration — linked PRs / commits / branches (Phase 9)
  giteaLinks IssueGiteaLink[]

  // Pages — cross-links from the knowledge base to this issue
  pageLinks PageIssueLink[]

  @@unique([projectId, number])
  @@index([projectId, statusId])
  @@index([statusId, rank])
  @@index([sprintId])
  @@index([assigneeId])
  @@index([parentId])
  // Covers keyset cursor pagination: WHERE projectId=X ORDER BY createdAt, id
  @@index([projectId, createdAt, id])
  // Covers overdue queries: WHERE dueDate < now() ORDER BY dueDate
  @@index([dueDate])
  // Additional indexes for NLQL / roadmap queries
  @@index([projectId, type])
  @@index([projectId, priority])
  @@index([projectId, assigneeId, statusId])
  @@index([projectId, sprintId, rank])
  @@index([projectId, dueDate])
  // Covers roadmap/Gantt range queries and NLQL startDate comparisons/sorting
  @@index([projectId, startDate])
  @@index([componentId])
  @@index([projectId, componentId])
}

// ---------------------------------------------------------------------------
// Checklist items (lightweight todo items on an issue)
// ---------------------------------------------------------------------------

model ChecklistItem {
  id        String   @id @default(cuid())
  issueId   String
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

// ---------------------------------------------------------------------------
// Join tables
// ---------------------------------------------------------------------------

model IssueLabel {
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
}

/// M:N join: an issue can target multiple versions (fix in v1.2 and backport to v1.1).
model IssueVersion {
  issueId   String
  versionId String

  issue   Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  version Version @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@id([issueId, versionId])
  @@index([versionId])
}

/// Directed link between two issues.
/// For symmetric types (RELATES_TO), a single row suffices.
/// For asymmetric pairs (BLOCKS/BLOCKED_BY, DUPLICATES/DUPLICATED_BY),
/// store only the canonical direction (BLOCKS / DUPLICATES) and derive the
/// inverse in application code.
model IssueLink {
  id          String        @id @default(cuid())
  sourceId    String
  targetId    String
  type        IssueLinkType
  createdAt   DateTime      @default(now())
  createdById String? // who created the link

  source    Issue @relation("linkSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target    Issue @relation("linkTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Issue children: Comment, ActivityLog, Watcher, Attachment
// ---------------------------------------------------------------------------

model Comment {
  id        String   @id @default(cuid())
  body      String
  issueId   String
  authorId  String? // nullable: author can be deleted (SetNull); display as "Deleted User"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([issueId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  issueId   String
  actorId   String? // nullable: actor can be deleted (SetNull); history is preserved
  field     String // e.g. "status", "assignee", "created"
  from      String?
  to        String?
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([issueId])
  @@index([actorId, createdAt])
  @@index([field, createdAt])
  // Composite index for the completionMap raw query, which filters
  // field='status', to IN (done-status IDs), createdAt BETWEEN window.
  // (field, to) equality narrows to status transitions for specific done-status
  // values; createdAt then supports the window range scan without a full sort.
  @@index([field, to, createdAt])
}

model Watcher {
  issueId String
  userId  String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
  @@index([userId])
}

// A per-recipient inbox item. Carries denormalized snapshot fields (issueKey,
// projectId, message) so the notification bell renders without N+1 lookups even
// if the source issue/comment later changes or is deleted.
model Notification {
  id        String           @id @default(cuid())
  userId    String // recipient
  type      NotificationType
  actorId   String? // who caused it (null if system / actor removed)
  issueId   String? // source issue (null if it was deleted)
  issueKey  String // e.g. "NL-12" — snapshot for rendering
  projectId String // for navigation to the right board
  message   String // short, pre-rendered summary line
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user    User     @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?    @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)
  issue   Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([projectId])
}

// A file attached to an issue. The raw file is stored on the local filesystem
// under UPLOADS_DIR (default ./uploads) by a UUID-based storageKey, so the
// client-supplied filename is never used as a path component. In K8s this
// directory maps to the `uploads` PVC provisioned by the Helm chart.
model Attachment {
  id         String   @id @default(cuid())
  issueId    String
  uploaderId String? // nullable: uploader can be deleted (SetNull); file metadata preserved
  filename   String // original client-supplied name (display only, never used as path)
  mimeType   String
  sizeBytes  Int
  storageKey String   @unique // UUID-based filename on disk; never trust client filename
  createdAt  DateTime @default(now())

  issue    Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploader User? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([issueId])
  @@index([uploaderId])
}

// ---------------------------------------------------------------------------
// Workspace-level audit log
// ---------------------------------------------------------------------------

// Workspace-level audit log: immutable record of security- and
// governance-relevant actions (membership changes, project lifecycle,
// webhook config, API-token create/revoke, etc.).
// actorId is nullable so system-generated events can still be recorded.
model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String? // null = system / actor deleted
  action      String // e.g. "membership.add", "project.create", "token.revoke"
  targetType  String // e.g. "Membership", "Project", "ApiToken"
  targetId    String // the id of the affected resource
  metadata    Json? // optional extra context (role, email, etc.)
  ip          String? // caller's IP, best-effort
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

// A read-only public share token for a project board. The URL encodes the raw
// token; only a SHA-256 hash is stored so a DB breach does not expose live
// share links. Revoked by setting revokedAt (soft-delete).
// Token format: "nls_" + 32 random bytes base64url.
model ShareToken {
  id          String    @id @default(cuid())
  projectId   String
  tokenHash   String    @unique // SHA-256 hex of the raw "nls_..." token
  createdById String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime? // null = active; non-null = revoked

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdById])
}

// An outbound webhook endpoint registered by a project admin. When matching
// domain events occur (issue.*, comment.created, sprint.*), Next Lane POSTs the
// event payload to `url` with an HMAC-SHA256 signature derived from `secret`.
// `events` holds the subscribed event-type strings (e.g. "issue.created"); an
// empty array means "all" events.
model WebhookSubscription {
  id        String   @id @default(cuid())
  projectId String
  url       String
  secret    String // HMAC signing secret (shared with the receiver)
  events    String[] // subscribed event types; empty = all events
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([projectId])
}

// A log entry for a single attempted webhook delivery. Kept for the admin's
// recent-deliveries view; old rows are pruned to a bounded count per
// subscription. `status` is "success" or "failed".
model WebhookDelivery {
  id             String   @id @default(cuid())
  subscriptionId String
  event          String
  status         String // "success" | "failed"
  responseStatus Int? // HTTP status from the receiver, if any
  error          String? // failure detail (timeout, non-2xx, network error)
  createdAt      DateTime @default(now())

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
}

// ---------------------------------------------------------------------------
// Planning Poker (Phase 5)
// ---------------------------------------------------------------------------

/// A facilitated estimation session for a set of issues.
///
/// `activeItemId` — tracks which PokerItem is currently being voted on.
/// Stored as a plain nullable string (not a Prisma FK relation) to avoid a
/// circular dependency between PokerSession and PokerItem; the application
/// layer validates that the value, when non-null, refers to a PokerItem that
/// belongs to this session.
///
/// Session lifecycle: VOTING → REVEALED → CLOSED (managed by the facilitator
/// via the API; transitions broadcast over Socket.io to all participants).
model PokerSession {
  id           String     @id @default(cuid())
  projectId    String
  sprintId     String? // optional sprint scope
  name         String?
  state        PokerState @default(VOTING)
  /// ID of the PokerItem currently open for voting. Application-maintained;
  /// not enforced as a DB FK to avoid a circular reference.
  activeItemId String?
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint    Sprint?     @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  createdBy User?       @relation("pokerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items     PokerItem[]

  @@index([projectId])
  @@index([sprintId])
}

/// One issue being estimated within a PokerSession.
/// `revealed` tracks whether the facilitator has flipped this item's cards
/// independently of the session state (allows per-item reveal in a multi-item flow).
/// `finalEstimate` is committed by the facilitator after discussion (story points).
model PokerItem {
  id            String   @id @default(cuid())
  sessionId     String
  issueId       String
  order         Int
  revealed      Boolean  @default(false)
  finalEstimate Int? // committed story points; null until the facilitator commits
  createdAt     DateTime @default(now())

  session PokerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  issue   Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  votes   PokerVote[]

  @@unique([sessionId, issueId])
  @@index([sessionId])
}

/// One participant's vote on a single PokerItem. Hidden from other participants
/// until the item or session is revealed. One vote per user per item; submitting
/// again overwrites the previous value (updatable via upsert on [itemId, userId]).
/// `value` is a deck card label: "1","2","3","5","8","13","21","?","☕", etc.
model PokerVote {
  id        String   @id @default(cuid())
  itemId    String
  userId    String
  value     String // card label from the deck; see POKER_DECK in packages/shared
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item PokerItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([itemId])
}

// ---------------------------------------------------------------------------
// Async Standups (Phase 10)
// ---------------------------------------------------------------------------

/// Daily async standup entry submitted by a user.
///
/// Scope: a standup is scoped to either a Team, a Project, or both. At least
/// one of `teamId` / `projectId` must be non-null — enforced at the service
/// layer (a DB constraint cannot express OR-not-null cleanly without a check
/// constraint, so the application validates this invariant before insert).
///
/// Unique constraint: @@unique([userId, teamId, projectId, date]) prevents a
/// user submitting more than one entry per scope per calendar day. Postgres 16
/// uses NULLS NOT DISTINCT semantics for multi-column unique indexes, meaning
/// two rows with the same (userId, NULL, projectId, date) values will correctly
/// collide rather than being treated as distinct. This is the cleanest
/// single-constraint expression of the business rule across all scope
/// combinations without requiring partial indexes.
///
/// `date` stores the standup day as a midnight-UTC DateTime (application must
/// normalise to date-only before writing). Full-precision DateTime is used
/// because Prisma does not expose a bare Date scalar for Postgres.
model StandupEntry {
  id        String   @id @default(cuid())
  userId    String
  teamId    String? // nullable — entry may be project-scoped only
  projectId String? // nullable — entry may be team-scoped only
  /// The standup calendar day. Store as midnight UTC (YYYY-MM-DDT00:00:00Z).
  date      DateTime
  yesterday String? // what the user did yesterday
  today     String? // what the user will do today
  blockers  String? // free-text description of blockers
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team    Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  blockerLinks StandupBlockerLink[]

  /// One entry per user per scope (team + project combination) per day.
  /// Postgres 16 NULLS NOT DISTINCT ensures NULL teamId / NULL projectId
  /// are treated as equal values within the unique index.
  @@unique([userId, teamId, projectId, date])
  @@index([teamId, date])
  @@index([projectId, date])
  @@index([userId, date])
}

/// Links a standup's free-text blockers field to specific tracked issues,
/// enabling cross-referencing between standups and the issue tracker.
model StandupBlockerLink {
  id             String   @id @default(cuid())
  standupEntryId String
  issueId        String
  createdAt      DateTime @default(now())

  standupEntry StandupEntry @relation(fields: [standupEntryId], references: [id], onDelete: Cascade)
  issue        Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([standupEntryId, issueId])
  @@index([standupEntryId])
  @@index([issueId])
}

// ---------------------------------------------------------------------------
// Personal Boards (Phase 10)
// ---------------------------------------------------------------------------

/// A user-owned kanban column in their private personal board.
/// Columns are private to the owner — there is no workspace or project
/// scoping. The application creates default columns (e.g. To Do / Doing /
/// Done) on first use; no seed data is required.
model PersonalColumn {
  id        String   @id @default(cuid())
  userId    String
  name      String
  order     Int
  /// Optional hex accent color for the column header/border.
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards PersonalCard[]

  @@index([userId])
}

/// A personal kanban card that lives in one of the user's PersonalColumns.
/// `rank` uses the same fractional-index scheme as Issue.rank for ordering
/// within a column. `promotedIssueId` is set (and thereafter immutable by
/// convention) when the card has been promoted to a real tracked issue.
model PersonalCard {
  id              String    @id @default(cuid())
  userId          String
  columnId        String
  title           String
  notes           String?
  /// Optional hex accent color (e.g. "#2563eb") shown as a left border/dot.
  color           String?
  /// Optional due date for the card.
  dueDate         DateTime?
  rank            String
  promotedIssueId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  column        PersonalColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  promotedIssue Issue?         @relation(fields: [promotedIssueId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([columnId, rank])
}

// ---------------------------------------------------------------------------
// Automation Engine — "Glass Box" rules (Phase 7)
// ---------------------------------------------------------------------------

/// A project-scoped rule that reacts to an issue event, evaluates an optional
/// NLQL condition, and executes an ordered list of actions.
///
/// `trigger`   — the domain event that causes this rule to be evaluated.
/// `condition` — an NLQL expression evaluated against the triggering issue.
///               NULL means "always match" (unconditional rule).
/// `actions`   — an ordered JSON array of action descriptors, e.g.:
///               [{"type":"SET_STATUS","statusId":"<id>"},
///                {"type":"ASSIGN","assigneeId":"<id>"}]
///               Validated and executed by the automation service; stored as
///               opaque JSONB so referenced entity IDs (status, assignee,
///               label, etc.) survive independent of hard FK constraints.
///               Deleting a referenced user/label/status will not cascade-
///               delete the rule — the action will simply fail at runtime and
///               the AutomationRun will record FAILED with an error message.
/// `order`     — evaluation priority within the project; lower = first.
/// `createdById` — nullable so deleting a user does not destroy the rule;
///               displays as "Deleted User" in the UI.
model AutomationRule {
  id          String            @id @default(cuid())
  projectId   String
  name        String
  description String?
  enabled     Boolean           @default(true)
  trigger     AutomationTrigger
  condition   String? // NLQL expression; null = unconditional
  actions     Json // ordered array of {type, ...params}
  order       Int               @default(0)
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  runs      AutomationRun[]

  // Fast lookup when an event fires: filter by project + enabled + trigger.
  @@index([projectId, enabled])
  @@index([projectId, trigger])
  @@index([createdById])
}

/// Immutable audit trail entry for a single AutomationRule evaluation.
///
/// `issueId`        — FK to the Issue that triggered the run. SetNull (not
///                    Cascade) is intentional: the audit history is valuable
///                    even after the issue is deleted (compliance, debugging).
///                    The run record survives; issueId becomes null.
/// `trigger`        — snapshot of the trigger at run time (matches the rule's
///                    trigger at the time of firing; denormalised for query
///                    convenience without a join to AutomationRule).
/// `matched`        — true if the NLQL condition passed (or was absent).
///                    false means SKIPPED (no actions executed).
/// `actionsApplied` — ordered array of action results, e.g.:
///                    [{"type":"SET_STATUS","detail":"done","ok":true}]
///                    Populated even on partial success so operators can see
///                    exactly what ran and what failed.
/// `error`          — human-readable error detail when status = FAILED.
model AutomationRun {
  id             String              @id @default(cuid())
  ruleId         String
  issueId        String? // nullable: SetNull when the issue is deleted
  trigger        AutomationTrigger
  matched        Boolean // did the condition evaluate to true?
  status         AutomationRunStatus
  actionsApplied Json // [{type, detail, ok}, ...]
  error          String? // non-null only when status = FAILED
  createdAt      DateTime            @default(now())

  rule  AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  issue Issue?         @relation(fields: [issueId], references: [id], onDelete: SetNull)

  // Run-history viewers: filter by rule or issue, sorted most-recent-first.
  @@index([ruleId, createdAt])
  @@index([issueId, createdAt])
}

// ---------------------------------------------------------------------------
// Configurable Workflows (Phase 2 / Phase 5)
// ---------------------------------------------------------------------------

/// A single allowed status transition in a project's configurable workflow.
///
/// Opt-in via Project.workflowEnforced (default false). When false, the
/// application ignores this table and permits all transitions (backward-compat).
/// When true, every status change must match at least one row here.
///
/// `fromStatusId` — null means "from any status / initial creation". This
///   models two cases: (a) an issue can be moved INTO `toStatus` from anywhere,
///   and (b) the implicit create→initial transition (issue is created directly
///   into `toStatus` without a prior status). Application code treats NULL as a
///   wildcard match on the source side.
///
/// `issueType` — null = applies to all issue types; non-null = only that type.
///   Lets teams define type-specific SDLC graphs (e.g. BUG has a "Won't Fix"
///   path that TASK does not).
///
/// `name` — optional human label shown in the UI transition button
///   (e.g. "Start Work", "Send for Review", "Resolve"). Null = derive from
///   toStatus.name in the UI.
///
/// `gates` — ordered JSONB array of pre-transition validator rules. The service
///   layer evaluates them in array order; all must pass for the transition to
///   proceed. Stored as opaque JSONB so the gate vocabulary can grow without a
///   schema migration. Initial supported gate types:
///     REQUIRE_ASSIGNEE        — issue must have an assignee
///     REQUIRE_DESCRIPTION     — issue.description must be non-empty
///     REQUIRE_FIELD           — a specific custom field must be set
///                               { type: "REQUIRE_FIELD", field: "<cfKey>" }
///     REQUIRE_LINK            — issue must have at least one link of linkType
///                               { type: "REQUIRE_LINK", linkType: "BLOCKS_PR" }
///     REQUIRE_NO_OPEN_BLOCKERS — issue must have no open BLOCKS links pointing to it
///   Example: [{"type":"REQUIRE_ASSIGNEE"},{"type":"REQUIRE_FIELD","field":"resolution"}]
///
/// Unique constraint decision: @@unique([projectId, fromStatusId, toStatusId, issueType])
///   This project targets Postgres 16, which supports NULLS NOT DISTINCT on
///   unique indexes (confirmed by StandupEntry precedent in this schema).
///   The constraint is therefore safe and correct — two rows with identical
///   (projectId, NULL fromStatusId, toStatusId, NULL issueType) will collide
///   as intended, preventing accidental duplicate wildcard transitions.
///   This also enables clean upsert semantics (findUnique + update/create) in
///   the service layer. Without it we would need app-layer dedupe + a
///   findFirst scan, which is error-prone under concurrent requests.
model WorkflowTransition {
  id           String     @id @default(cuid())
  projectId    String
  /// Null = "from any status" (wildcard source / initial creation).
  fromStatusId String?
  toStatusId   String
  /// Null = transition applies to all issue types.
  issueType    IssueType?
  /// Optional human label for this transition (e.g. "Start Work", "Resolve").
  name         String?
  /// Ordered array of gate/validator rules evaluated before the transition is
  /// allowed. Empty array = no gates (transition is always permitted when selected).
  /// See model-level comment for the supported gate type vocabulary.
  gates        Json       @default("[]")
  /// Null = legacy project-level transition (workflowId path not used).
  /// Non-null = belongs to a named Workflow; enforced via that workflow.
  workflowId   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The status this transition originates FROM. Null = any/initial.
  fromStatus Status?   @relation("transitionFromStatus", fields: [fromStatusId], references: [id], onDelete: Cascade)
  /// The status this transition leads INTO. Always required.
  toStatus   Status    @relation("transitionToStatus", fields: [toStatusId], references: [id], onDelete: Cascade)
  /// Named workflow this transition belongs to; null = legacy project-level row.
  workflow   Workflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  /// Prevents exact duplicate legacy transitions (null workflowId path).
  /// Postgres 16 NULLS NOT DISTINCT ensures NULL rows collide correctly.
  @@unique([projectId, fromStatusId, toStatusId, issueType])
  /// Prevents exact duplicate transitions within a named workflow.
  /// Postgres 16 NULLS NOT DISTINCT applies here too.
  @@unique([workflowId, fromStatusId, toStatusId, issueType])
  /// Fast "what transitions are legal for this issue type in this project?" query.
  @@index([projectId, issueType])
  /// Fast "what transitions can leave this specific status?" query.
  @@index([projectId, fromStatusId])
  /// Fast "what transitions lead INTO a specific status for a project?" query.
  @@index([projectId, toStatusId])
  /// Workflow-scoped transitions index.
  @@index([workflowId])
}

// ---------------------------------------------------------------------------
// Named Workflows (per-board workflow definitions — Feature 1)
// ---------------------------------------------------------------------------

/// A named, project-scoped workflow definition. Boards can opt into a specific
/// Workflow rather than the legacy project-level workflowEnforced flag.
/// Null workflowId on a Board = legacy path (backward-compatible).
model Workflow {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  /// When true, only transitions defined in this workflow's transitions are
  /// legal for boards that reference it. When false, enforcement is relaxed.
  enforced    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transitions WorkflowTransition[]
  boards      Board[]

  @@unique([projectId, name])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Time Tracking — WorkLog (Feature 2)
// ---------------------------------------------------------------------------

/// A time-log entry recording how many minutes a user spent on an issue.
/// `workedAt` is when the work was actually performed (defaults to log time).
/// `note` is an optional free-text description of what was done.
model WorkLog {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  /// Duration in minutes.
  minutes   Int
  note      String?
  workedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Issue Templates (Feature 3)
// ---------------------------------------------------------------------------

/// A project-scoped template for pre-populating new issue fields.
/// `labelIds` is a JSONB array of Label.id strings (M:N without a join table,
/// since templates are rarely queried by label — they are write-path helpers).
model IssueTemplate {
  id                  String    @id @default(cuid())
  projectId           String
  name                String
  issueType           IssueType @default(TASK)
  titleTemplate       String?
  descriptionTemplate String?
  priority            Priority?
  defaultAssigneeId   String?
  componentId         String?
  /// JSON array of Label.id strings to apply when creating from this template.
  labelIds            Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  defaultAssignee User?      @relation("templateDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  component       Component? @relation("templateComponent", fields: [componentId], references: [id], onDelete: SetNull)

  @@unique([projectId, name])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// GitHub integration (Phase 9 — Developer Graph, v1 two-way link)
// ---------------------------------------------------------------------------

/// The kind of GitHub object an IssueGithubLink points to.
enum GithubLinkKind {
  PR
  COMMIT
  BRANCH
}

/// Per-project GitHub repository link configuration. ADMIN-managed. One row
/// per project (unique projectId) — v1 scope is a single repo per project.
///
/// `tokenEncrypted` — the GitHub PAT, AES-256-GCM encrypted at rest (never
///   stored in plaintext, unlike a one-way hash — a future outbound
///   GithubClient call, e.g. polling PR/CI status, needs to present the raw
///   token to the GitHub API, so a one-way hash like ApiToken.tokenHash is
///   not sufficient here). Encryption key is derived from
///   GITHUB_TOKEN_ENCRYPTION_KEY (falls back to JWT_SECRET for zero-config
///   self-host — see github-crypto.util.ts). Never returned by any API response.
/// `webhookSecret` — HMAC signing secret the self-hoster pastes into GitHub's
///   repo webhook settings ("Secret" field); the inbound webhook receiver
///   verifies `X-Hub-Signature-256` against this value before processing any
///   payload. Generated once at creation; not rotated by a plain PUT (v1).
/// Instance-level SSO/OIDC configuration, editable from an in-app admin
/// settings screen (`GET`/`PATCH /admin/oidc-config`, instance-admin gated)
/// instead of requiring an env-var edit + API redeploy. Single-row table —
/// always addressed by the fixed id `"singleton"` (see
/// `OIDC_CONFIG_SINGLETON_ID` in `oidc-config.service.ts`).
///
/// Precedence: `OIDC_ISSUER_URL`/`OIDC_CLIENT_ID`/`OIDC_CLIENT_SECRET` env
/// vars WIN over this table when all three are set (12-factor: operators who
/// pin config in the environment keep that behavior unchanged) — this row is
/// the fallback/UI-editable path for self-hosters who'd rather configure SSO
/// from the app than redeploy. `clientSecretEncrypted` mirrors
/// `GithubIntegration.tokenEncrypted` exactly (AES-256-GCM, reversible —
/// the OIDC client needs the raw secret for token exchange — via the shared
/// `apps/api/src/common/crypto/secret-crypto.util.ts` helper); never
/// returned by any API response (`OidcConfigDto.hasClientSecret` only).
model OidcConfig {
  id                    String   @id
  enabled               Boolean  @default(false)
  issuerUrl             String?
  clientId              String?
  clientSecretEncrypted String?
  label                 String?
  /// SSO/OIDC Phase 2 (additive, nullable — existing rows keep working
  /// unmigrated): just-in-time workspace auto-provisioning for a BRAND NEW
  /// user's first login through this (legacy, always-on-when-configured)
  /// provider. Null = off (Phase-1 behavior, unchanged): the user account is
  /// created but no workspace membership is auto-created. Mirrors
  /// `SsoProvider.jitDefaultWorkspaceId`/`jitDefaultRole` exactly — see that
  /// model's doc comment for the semantics.
  jitDefaultWorkspaceId String?
  jitDefaultRole        Role     @default(VIEWER)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// SSO/OIDC Phase 2 — a single admin-configured identity provider in the
/// N-simultaneous-providers list surfaced by `/admin/sso`. Deliberately a
/// SEPARATE table from the Phase-1 `OidcConfig` singleton rather than a
/// migration of it: `OidcConfig` (env-var-precedence, single generic OIDC
/// provider) keeps working entirely unmigrated for any existing deployment,
/// and every row in THIS table is an ADDITIONAL provider layered alongside
/// it — the login page renders one button per enabled row here, plus the
/// legacy OIDC button when `OidcConfigService.isConfigured()` is true. There
/// is no data migration between the two tables; an admin who wants the
/// legacy provider to appear as a first-class row here can re-enter its
/// details as a new row (the old one keeps working either way).
///
/// Type-specific columns (`issuerUrl`/`clientId`/`clientSecretEncrypted` for
/// OIDC; `samlEntryPoint`/`samlIdpIssuer`/`samlIdpCertificate`/
/// `samlSpEntityId`/`samlWantAssertionsSigned` for SAML) are nullable and
/// mutually exclusive by `type`, enforced at the DTO/service layer (Prisma
/// has no CHECK-constraint-by-discriminator support worth the complexity
/// here — mirrors how `GithubIntegration`/`GitlabIntegration`/
/// `GiteaIntegration` each get their own table rather than one polymorphic
/// "forge" table).
///
/// `slug` is the stable, admin-chosen (or auto-generated from `label`)
/// identifier used in the runtime route path (`/api/auth/sso/:slug/login`
/// and `/callback`) and, for OIDC, as part of the client-discovery cache
/// key — changing `label` never breaks a previously-registered redirect URI
/// because `slug` is independent of it.
///
/// JIT provisioning (`jitDefaultWorkspaceId`/`jitDefaultRole`): when a brand
/// new SSO identity (no existing `User` row for that email) completes login
/// through this provider AND `jitDefaultWorkspaceId` is set, a `Membership`
/// row is auto-created at `jitDefaultRole` (default `VIEWER` — conservative:
/// an admin must explicitly opt into a higher default) with no pre-existing
/// invite required. When `jitDefaultWorkspaceId` is null (the default for a
/// newly-created provider), JIT provisioning is off: the user account is
/// still created on first SSO login (so they can authenticate), but they
/// land with zero workspace memberships until an existing member invites
/// them — the safe, opt-in default. JIT never touches an ALREADY-EXISTING
/// user's memberships on a later login, by design (see `sso.service.ts`).
model SsoProvider {
  id      String          @id @default(cuid())
  type    SsoProviderType
  enabled Boolean         @default(true)
  label   String
  slug    String          @unique

  // ── OIDC (type = OIDC); null when type = SAML ──────────────────────────
  issuerUrl             String?
  clientId              String?
  clientSecretEncrypted String?

  // ── SAML (type = SAML); null when type = OIDC ──────────────────────────
  /// The IdP's SSO endpoint (HTTP-Redirect binding) the SP-initiated
  /// AuthnRequest is sent to.
  samlEntryPoint           String?
  /// The IdP's Entity ID (`<Issuer>` expected on the assertion).
  samlIdpIssuer            String?
  /// One or more PEM-encoded X.509 certificates (concatenated) used to
  /// verify the IdP's assertion/response signature. Required — SAML
  /// responses are NEVER accepted unsigned (see `saml.service.ts`).
  samlIdpCertificate       String?
  /// Our SP Entity ID / expected `<AudienceRestriction>` value. Defaults to
  /// `${WEB_BASE_URL}/api/auth/sso/{slug}` when null (computed, never
  /// stored as null-meaning-"skip the check" — audience is always enforced).
  samlSpEntityId           String?
  /// Always true in practice (the admin form has no toggle for this — see
  /// `dto/create-sso-provider.dto.ts`); persisted so the enforcement is
  /// explicit and reviewable per-row rather than implied by application code
  /// alone.
  samlWantAssertionsSigned Boolean @default(true)

  // ── JIT provisioning (applies to both types) ───────────────────────────
  jitDefaultWorkspaceId String?
  jitDefaultRole        Role    @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jitDefaultWorkspace Workspace? @relation(fields: [jitDefaultWorkspaceId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([jitDefaultWorkspaceId])
}

model GithubIntegration {
  id                     String   @id @default(cuid())
  projectId              String   @unique
  /// "owner/repo" — validated at the DTO layer.
  repoFullName           String
  tokenEncrypted         String
  webhookSecret          String
  /// When true, a `merged` pull_request webhook event auto-moves every
  /// linked issue to `autoTransitionStatusId` via the existing
  /// workflow-transition enforcement path's automation-bypass flag (same
  /// mechanism the automation engine's TRANSITION action uses). Off by
  /// default — this is an opt-in per-project automation, not a default
  /// behavior change.
  autoTransitionOnMerge  Boolean  @default(false)
  /// The target status applied on merge when `autoTransitionOnMerge` is on.
  /// Null while unconfigured; enabling the toggle requires a status to be
  /// selected (enforced at the service layer, not the DB).
  autoTransitionStatusId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project              Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// SetNull (not a hard block) so deleting the target status doesn't corrupt
  /// the integration row — the toggle just stops firing until re-configured.
  autoTransitionStatus Status? @relation("githubAutoTransitionStatus", fields: [autoTransitionStatusId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([autoTransitionStatusId])
}

/// A link between a tracked Issue and a GitHub object (pull request, commit,
/// or branch), created/updated by the inbound webhook handler when a commit
/// message or PR title/branch name references the issue's key (e.g. "NL-123").
///
/// `externalId` — PR number (as a string), commit SHA, or branch name
///   depending on `kind`. Combined with `kind` this is the natural GitHub-side
///   identity, so re-delivered webhook events upsert idempotently instead of
///   creating duplicate rows.
/// `state` — PR: "open" | "closed" | "merged". COMMIT/BRANCH: null (no
///   GitHub-side lifecycle state to track for those object kinds).
model IssueGithubLink {
  id          String         @id @default(cuid())
  issueId     String
  kind        GithubLinkKind
  externalId  String
  title       String?
  url         String
  state       String?
  authorLogin String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, kind, externalId])
  @@index([issueId])
}

// ---------------------------------------------------------------------------
// GitLab integration (Phase 9 — Developer Graph, v1 two-way link)
//
// Deliberately a PARALLEL table pair (GitlabIntegration/IssueGitlabLink)
// mirroring GithubIntegration/IssueGithubLink shape-for-shape, rather than
// generalizing the GitHub tables behind a provider column — additive and
// zero-risk to the already-shipped GitHub rows/migrations. A future
// "unify behind a provider-tagged ScmIntegration/IssueScmLink pair" migration
// remains an option once a third provider (Gitea) makes the duplication cost
// outweigh the migration risk; not attempted in this pass.
// ---------------------------------------------------------------------------

/// The kind of GitLab object an IssueGitlabLink points to. "MR" (merge
/// request) is GitLab's name for what GitHub calls a "pull request".
enum GitlabLinkKind {
  MR
  COMMIT
  BRANCH
}

/// Per-project GitLab repository link configuration. ADMIN-managed. One row
/// per project (unique projectId) — v1 scope is a single GitLab project per
/// Next Lane project, mirroring GithubIntegration.
///
/// `gitlabBaseUrl` — the GitLab instance origin (default `https://gitlab.com`).
///   Self-hosted GitLab (and, eventually, Gitea) support is core to Next
///   Lane's self-hosted audience, so this is a first-class field rather than
///   a hardcoded SaaS host the way GitHub's integration is.
/// `projectPath` — the GitLab "namespace/project" path (may include nested
///   subgroups, e.g. "group/subgroup/project"), used both to build API calls
///   and for display. Validated at the DTO layer.
/// `tokenEncrypted` — a GitLab Personal Access Token, AES-256-GCM encrypted
///   at rest via the same shared `common/crypto/secret-crypto.util.ts`
///   primitive GithubIntegration uses (see `gitlab-crypto.util.ts`). Never
///   returned by any API response.
/// `webhookSecret` — the literal "Secret Token" value pasted into GitLab's
///   webhook settings. Unlike GitHub (which HMAC-signs the body), GitLab
///   sends this value back verbatim in the `X-Gitlab-Token` header on every
///   delivery; the inbound webhook receiver verifies it with a timing-safe
///   equality compare. Generated once at creation; not rotated by a plain PUT.
model GitlabIntegration {
  id                     String   @id @default(cuid())
  projectId              String   @unique
  gitlabBaseUrl          String   @default("https://gitlab.com")
  projectPath            String
  tokenEncrypted         String
  webhookSecret          String
  /// Mirrors `GithubIntegration.autoTransitionOnMerge` exactly — a `merged`
  /// Merge Request Hook event auto-moves every linked issue to
  /// `autoTransitionStatusId`. Off by default.
  autoTransitionOnMerge  Boolean  @default(false)
  autoTransitionStatusId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project              Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  autoTransitionStatus Status? @relation("gitlabAutoTransitionStatus", fields: [autoTransitionStatusId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([autoTransitionStatusId])
}

/// A link between a tracked Issue and a GitLab object (merge request, commit,
/// or branch), created/updated by the inbound webhook handler when a commit
/// message or MR title/description/branch name references the issue's key
/// (e.g. "NL-123"). Mirrors IssueGithubLink exactly.
///
/// `externalId` — MR `iid` (project-scoped merge request number, as a
///   string), commit SHA, or branch name depending on `kind`. Combined with
///   `kind` this is the natural GitLab-side identity, so re-delivered webhook
///   events upsert idempotently instead of creating duplicate rows.
/// `state` — MR: "open" | "closed" | "merged" | "locked" (GitLab's "opened"
///   is normalized to "open" for consistency with the GitHub link's
///   vocabulary). COMMIT/BRANCH: null.
model IssueGitlabLink {
  id          String         @id @default(cuid())
  issueId     String
  kind        GitlabLinkKind
  externalId  String
  title       String?
  url         String
  state       String?
  authorLogin String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, kind, externalId])
  @@index([issueId])
}

// ---------------------------------------------------------------------------
// Gitea integration (Phase 9 — Developer Graph, third self-hosted forge)
//
// Another PARALLEL table pair (GiteaIntegration/IssueGiteaLink), same
// rationale as GitlabIntegration/IssueGitlabLink above — additive/zero-risk
// to the already-shipped GitHub and GitLab rows rather than a provider-tagged
// generalization (still deferred; three parallel pairs is the point at which
// the duplication cost starts to outweigh the migration risk, tracked as a
// future "unify behind ScmIntegration" option, not attempted this pass).
//
// Gitea's webhook scheme is HMAC-SHA256 (`X-Gitea-Signature`, hex-encoded,
// no "sha256=" prefix unlike GitHub) — closer to GithubIntegration's
// verification shape than GitlabIntegration's shared-secret-token compare.
// v1 deliberately omits the `autoTransitionOnMerge`/`autoTransitionStatusId`
// pair GithubIntegration/GitlabIntegration carry (see their PR-status +
// auto-transition-on-merge follow-up) — links only, no automation, no
// outbound API client/live-status call in this pass.
// ---------------------------------------------------------------------------

/// The kind of Gitea object an `IssueGiteaLink` points to. Mirrors
/// `GithubLinkKind` exactly — Gitea calls it "pull request" too (unlike
/// GitLab's "merge request").
enum GiteaLinkKind {
  PR
  COMMIT
  BRANCH
}

/// Per-project Gitea repository link configuration. ADMIN-managed. One row
/// per project (unique projectId) — v1 scope is a single repo per project.
///
/// `giteaBaseUrl` — the self-hosted Gitea instance origin. REQUIRED (unlike
///   `GitlabIntegration.gitlabBaseUrl`, which defaults to the gitlab.com SaaS
///   host, Gitea has no canonical single-tenant SaaS home — every deployment
///   is a distinct self-hosted instance, so there is no sensible default).
/// `repoFullName` — "owner/repo", validated at the DTO layer, mirrors
///   `GithubIntegration.repoFullName`.
/// `tokenEncrypted` — a Gitea access token, AES-256-GCM encrypted at rest via
///   the same shared `common/crypto/secret-crypto.util.ts` primitive
///   GithubIntegration/GitlabIntegration use (see `gitea-crypto.util.ts`).
///   Reversible (not a one-way hash) so a future outbound `GiteaClient` call
///   could present it to the Gitea API, though v1 makes no such call — the
///   inbound webhook payload carries everything v1 needs. Never returned by
///   any API response.
/// `webhookSecret` — the HMAC signing secret pasted into Gitea's webhook
///   settings ("Secret" field); the inbound webhook receiver verifies
///   `X-Gitea-Signature` against this value before processing any payload.
///   Generated once at creation; not rotated by a plain PUT (v1).
model GiteaIntegration {
  id             String   @id @default(cuid())
  projectId      String   @unique
  giteaBaseUrl   String
  repoFullName   String
  tokenEncrypted String
  webhookSecret  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// A link between a tracked Issue and a Gitea object (pull request, commit,
/// or branch), created/updated by the inbound webhook handler when a commit
/// message or PR title/branch name references the issue's key (e.g.
/// "NL-123"). Mirrors IssueGithubLink exactly.
///
/// `externalId` — PR number (as a string), commit SHA, or branch name
///   depending on `kind`. Combined with `kind` this is the natural
///   Gitea-side identity, so re-delivered webhook events upsert idempotently
///   instead of creating duplicate rows.
/// `state` — PR: "open" | "closed" | "merged". COMMIT/BRANCH: null.
model IssueGiteaLink {
  id          String        @id @default(cuid())
  issueId     String
  kind        GiteaLinkKind
  externalId  String
  title       String?
  url         String
  state       String?
  authorLogin String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, kind, externalId])
  @@index([issueId])
}

// ---------------------------------------------------------------------------
// Dashboards (configurable, NLQL-native gadget framework)
// ---------------------------------------------------------------------------

/// A per-project dashboard: an ordered collection of gadgets. Projects can
/// have multiple dashboards (e.g. "Team overview", "Bug triage"); `order`
/// controls the tab/list order.
model Dashboard {
  id        String   @id @default(cuid())
  projectId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gadgets     DashboardGadget[]
  shareTokens DashboardShareToken[]

  @@index([projectId])
}

/// A single gadget on a dashboard. Every gadget — built-in-feeling or fully
/// custom — is defined the same way: an NLQL `query` (evaluated through the
/// shared validator/evaluator, no parallel query path) plus a `visualization`
/// that shapes the filtered issue set for display.
///
/// `config` is a small JSON bag holding visualization-specific + grid-layout
/// settings (e.g. `{ field: "status" }` for BREAKDOWN, `{ columns: [...],
/// limit: 10 }` for TABLE, and `{ position, size }` for every gadget's place
/// in the dashboard's CSS grid). Kept as JSON rather than dedicated columns
/// so new visualization types (Phase 2) don't need a schema migration.
model DashboardGadget {
  id            String                       @id @default(cuid())
  dashboardId   String
  title         String
  /// NLQL query string — the single source of truth for which issues this
  /// gadget covers. Validated server-side before every evaluation.
  query         String
  visualization DashboardGadgetVisualization @default(STAT)
  config        Json?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
}

/// A public, read-only share link for a single dashboard — the dashboard
/// analogue of `ShareToken` (which scopes to a project board). Kept as its
/// own table rather than widening `ShareToken` with a nullable `dashboardId`:
/// `ShareToken.projectId` is a required column that every existing read/write
/// path (`ShareTokensService`, `PublicService`) treats as always-present, and
/// dashboards and boards are never the same resource — a board link must
/// never be presentable as a dashboard link or vice versa. A parallel table
/// keeps both FKs required + `onDelete: Cascade` precise, avoids a discriminator
/// column / nullable-FK CHECK constraint, and needs zero changes to the
/// existing, already-tested `ShareToken` surface. See `share-tokens/` for the
/// board equivalent this mirrors field-for-field.
model DashboardShareToken {
  id          String    @id @default(cuid())
  dashboardId String
  tokenHash   String    @unique // SHA-256 hex of the raw "nls_..." token
  createdById String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime? // null = active; non-null = revoked

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Agent context (per-project agent handoff memory — founder directive
// 2026-07-03: "for each project a LLM via the MCP should be able to dump
// their context for the next run or agent")
// ---------------------------------------------------------------------------

/// A single, shared, per-project markdown "handoff" document that AI agents
/// (and humans) read at the start of a work session and write before ending
/// one — the project's persistent working memory across separate agent runs.
///
/// Deliberately ONE row per project (not versioned/append-only): the whole
/// point is a living document an agent replaces wholesale with a fresh
/// handoff, not a growing log (that's what ActivityLog/AuditEvent already
/// are). `content` is capped at 64 KiB at the DTO layer (see
/// `agent-context/dto/upsert-agent-context.dto.ts`) so it can never grow
/// unbounded.
model ProjectAgentContext {
  id          String   @id @default(cuid())
  projectId   String   @unique
  /// Markdown handoff document. Empty string until the first write (no row
  /// exists at all before that — see `AgentContextService.get`).
  content     String   @default("")
  /// Nullable: the user (human OR the user whose PAT an agent authenticated
  /// as) who made the most recent write; SetNull preserves the document if
  /// that account is later deleted.
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Idempotency (Agent Experience Round 2, criterion 2 — founder-relayed field
// report #2: an agent retried create_issue/add_comment after a network blip
// and got duplicate tickets, twice.)
// ---------------------------------------------------------------------------

/// Records the response of a mutating call made with a client-supplied
/// `idempotencyKey`, so a retried call with the SAME key (scoped to the same
/// user + endpoint) replays the ORIGINAL response instead of re-running the
/// mutation. No relation to `User` — rows are keyed by userId as a plain
/// string and expire on a 24h window (checked in application code); cleanup
/// is opportunistic (a `deleteMany` of expired rows fires after each new
/// write) rather than a scheduled job, since a self-hosted single-instance
/// deployment doesn't need one for a table this small and short-lived.
model IdempotencyRecord {
  id           String   @id @default(cuid())
  /// Client-supplied idempotency key (opaque string, e.g. a UUID the caller
  /// generates once and reuses across retries of the SAME logical request).
  key          String
  userId       String
  /// Logical endpoint identifier, e.g. "POST /issues" or "POST comments" —
  /// scopes the key so the same key string can't collide across unrelated
  /// mutation types for the same user.
  endpoint     String
  /// The JSON response body that was returned the first time this key was
  /// used for this user+endpoint — replayed verbatim on a retry within the
  /// window. NULL while the first request is still executing: the row is
  /// inserted as a claim BEFORE the mutation runs (claim-first), so a
  /// concurrent duplicate polls for this to fill in rather than re-running
  /// the mutation.
  responseBody Json?
  /// SHA-256 of the logical request payload recorded with the claim. A
  /// replay whose payload hash differs gets a 409 instead of silently
  /// replaying the first response (reused-key caller bug).
  requestHash  String   @default("")
  createdAt    DateTime @default(now())

  @@unique([key, userId, endpoint])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Pages — Confluence-style knowledge base (project-scoped page tree)
// ---------------------------------------------------------------------------

/// A project-scoped, nestable document page. Pages form a tree via the
/// self-referencing `parentId` (top-level pages have `parentId = null`);
/// sibling order within a parent (or within the top-level list) is a
/// fractional-index `rank` string, same scheme as `Issue.rank` — see
/// `rankBetween`/`rankAfter`/`rankBefore` in `packages/shared/src/rank.ts`.
///
/// `content` holds the LIVE markdown body. `PageVersion` is the append-only
/// history: every save (including the page's very first save) writes a new
/// `PageVersion` snapshot, so `Page.content` is always exactly equal to the
/// content of its latest `PageVersion` row and the two are never a separate
/// source of truth to reconcile. This (vs. treating "the latest PageVersion"
/// as the canonical current content with no live column on Page) is
/// deliberate: nearly every read path (page view, search, the tree sidebar,
/// NLQL/agent tooling) wants the current content with a single-table lookup
/// and no "fetch the page, then fetch its MAX(versionNumber) row" join or
/// N+1; only the history/diff/revert UI needs to walk `PageVersion`, and that
/// stays a cheap, explicitly-opted-into query. A denormalized live column is
/// the same tradeoff this schema already makes elsewhere (e.g.
/// `ProjectAgentContext.content` is the live doc with no version table at
/// all); here we additionally get full history without giving up the fast path.
/// Length is uncapped at the DB layer (plain `String` -> Postgres TEXT, no
/// `@db.VarChar`); the DTO layer enforces a generous ~256 KiB cap on write
/// (pages are longer-form docs than the 64 KiB `ProjectAgentContext` handoff
/// note — see that model's comment for the precedent this mirrors).
///
/// `parentId` onDelete: Restrict — deliberately NOT Cascade or SetNull.
/// Deleting a page that has children is an inherently ambiguous, destructive
/// operation with three very different reasonable outcomes (delete the whole
/// subtree too / promote the children to root / reparent them to the
/// deleted page's own parent), and a plain FK action can only ever implement
/// ONE of those silently:
///   - `Cascade` would silently wipe out an entire subtree just because its
///     root was deleted — the "cascade a whole subtree unexpectedly" failure
///     mode call out below.
///   - `SetNull` would silently flatten the tree (children jump to top-level)
///     with no record that a restructure happened — surprising and, unlike
///     Issue.parentId's SetNull (where a sub-task losing its epic link is a
///     low-stakes, easily-visible/undo-able field change), here it can
///     silently rewrite a whole document tree's navigation structure.
/// `Restrict` instead makes the database refuse the delete outright while a
/// page still has children, forcing the service layer to make an EXPLICIT,
/// intentional choice before the delete can proceed (e.g. require the caller
/// to first re-parent or delete the children, or expose a dedicated
/// "delete subtree" endpoint that cascades inside one transaction after
/// explicit user confirmation). This is the same conservative posture this
/// schema already takes for FKs where an implicit action would be surprising
/// (e.g. `Notification.projectId` and most Cascade FKs are the "safe to lose
/// the dependent row" case; Restrict is reserved for "the dependent rows are
/// themselves independently valuable and losing/moving them needs to be a
/// deliberate act").
model Page {
  id             String   @id @default(cuid())
  projectId      String
  /// Self-relation for the nestable tree. Null = top-level page. See the
  /// model-level comment for why this FK is `onDelete: Restrict`.
  parentId       String?
  title          String
  /// Live markdown body. See model-level comment: this is always the content
  /// of the latest `PageVersion` row for this page.
  content        String   @default("")
  /// Fractional-index sibling order (within the same parent, including the
  /// top-level list where parentId is null). See `packages/shared/src/rank.ts`.
  rank           String
  archived       Boolean  @default(false)
  /// Nullable: the user who originally created the page; SetNull preserves
  /// the page if that account is later deleted.
  authorId       String?
  /// Nullable: the user who made the most recent edit; SetNull preserves the
  /// page if that account is later deleted.
  lastEditedById String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Generated tsvector for full-text search (title + content), managed
  // entirely by Postgres (GENERATED ALWAYS AS ... STORED). Prisma cannot
  // read/write this directly — FTS goes through $queryRaw. The GIN index
  // "Page_searchVector_idx" is created via raw SQL in the add-pages-fts
  // migration. Mirrors Issue.searchVector.
  searchVector   Unsupported("tsvector")?

  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent        Page?           @relation("pageTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Page[]          @relation("pageTree")
  author        User?           @relation("pageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  lastEditedBy  User?           @relation("pageLastEditedBy", fields: [lastEditedById], references: [id], onDelete: SetNull)
  versions      PageVersion[]
  issueLinks    PageIssueLink[]
  /// Obsidian-style `[[wiki-links]]` this page contains (outbound edges).
  outgoingLinks PageLink[]      @relation("PageOutgoing")
  /// Backlinks — other pages whose body links TO this page (inbound edges;
  /// the source of the "what links here" panel and graph-view edges).
  incomingLinks PageLink[]      @relation("PageIncoming")

  // Fast "children of this parent within this project" / tree-render query
  // (also covers "top-level pages of a project" where parentId is null).
  @@index([projectId, parentId])
  // Fast "ordered page list for a project" query (backlog/sidebar-style scan).
  @@index([projectId, rank])
}

/// An immutable snapshot of a `Page`'s title + content at one point in time —
/// Confluence-style version history. A new row is written on every save of
/// the page, including the very first (so history is complete from creation,
/// never starting mid-way). `versionNumber` is monotonically increasing per
/// page (1, 2, 3, ...), assigned by the service layer (not a DB sequence, so
/// it can be computed alongside the same transaction that updates
/// `Page.content`/`Page.updatedAt`). See `Page`'s model-level comment for why
/// `Page.content` (not "the latest PageVersion row") is the canonical current
/// content.
model PageVersion {
  id            String   @id @default(cuid())
  pageId        String
  /// Monotonic per-page version counter, starting at 1. Service-assigned.
  versionNumber Int
  /// Snapshot of the page's title at save time (titles can change between
  /// versions too, not just content).
  title         String
  /// Snapshot of the page's markdown body at save time.
  content       String
  /// Nullable: who made this particular edit; SetNull preserves the
  /// historical snapshot if that account is later deleted.
  editedById    String?
  createdAt     DateTime @default(now())

  page     Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  editedBy User? @relation(fields: [editedById], references: [id], onDelete: SetNull)

  @@unique([pageId, versionNumber])
  // History-list query: "most recent versions of this page first".
  @@index([pageId, versionNumber(sort: Desc)])
}

/// Cross-link between a `Page` and an `Issue` — lets a knowledge-base page
/// reference (and be referenced from) specific tracked issues, mirroring the
/// `IssueLink` pattern used for issue-to-issue links but simpler: a page/issue
/// association has no direction/type vocabulary (BLOCKS, DUPLICATES, ...) the
/// way two issues can relate, it is a single plain association, so there is
/// no `type` column here.
///
/// Tenant constraint (service-layer enforced, not a DB constraint — Prisma/
/// Postgres cannot express a cross-row-scope FK check declaratively): the
/// linked `Page` and `Issue` must belong to the SAME `projectId`. Both sides
/// are already independently project-scoped (`Page.projectId`,
/// `Issue.projectId`); the service that creates a `PageIssueLink` must load
/// both rows and reject the link (400) if their `projectId`s differ, the same
/// way cross-project `IssueLink`s are guarded today.
model PageIssueLink {
  id        String   @id @default(cuid())
  pageId    String
  issueId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page  Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([pageId, issueId])
  @@index([pageId])
  @@index([issueId])
}

/// A directed page-to-page link — the backing store for Obsidian-style
/// `[[wiki-links]]` embedded in a page's markdown body, and therefore the
/// edge table for both the graph view and the "backlinks" / "what links
/// here" panel. Distinct from `PageIssueLink` (page <-> issue) — this is
/// page <-> PAGE.
///
/// `sourcePageId` — the page whose body contains the `[[link]]`.
/// `targetPageId` — the page being linked to.
/// Both FKs are `onDelete: Cascade`: a link edge has no meaning once either
/// endpoint page is gone (unlike `Page.parentId`'s Restrict — a wiki-link
/// reference is not a structural/ownership relationship the way tree nesting
/// is, so losing the edge silently when either page is deleted is the
/// expected, low-stakes outcome, same posture as `IssueLink`'s Cascade FKs).
///
/// One row per (source, target) pair — `@@unique([sourcePageId, targetPageId])`
/// collapses repeated `[[links]]` to the same target within one page's body
/// into a single graph edge; re-parsing a page's content on save should
/// upsert against this constraint (delete-then-recreate the page's outgoing
/// set, or diff) rather than insert duplicates.
///
/// Both indexes are load-bearing for different queries: `sourcePageId` powers
/// "what does this page link out to" (rendering the page's outbound links),
/// while `targetPageId` powers "what links here" (the backlinks panel) and,
/// combined with `sourcePageId`, the full edge set for a project's graph view.
///
/// Tenant constraint (service-layer enforced, same pattern as
/// `PageIssueLink`): source and target pages must belong to the same
/// `projectId` — the graph view is per-project, never cross-project. A
/// self-link (`sourcePageId === targetPageId`) is also a service-layer
/// rejection (a page linking to itself is not a meaningful graph edge); not
/// modeled as a DB CHECK constraint to keep this consistent with how the rest
/// of this schema handles application-level invariants (see `PageIssueLink`'s
/// tenant-constraint note).
model PageLink {
  id           String   @id @default(cuid())
  sourcePageId String
  targetPageId String
  createdAt    DateTime @default(now())

  sourcePage Page @relation("PageOutgoing", fields: [sourcePageId], references: [id], onDelete: Cascade)
  targetPage Page @relation("PageIncoming", fields: [targetPageId], references: [id], onDelete: Cascade)

  @@unique([sourcePageId, targetPageId])
  // Outbound: "pages this page links to".
  @@index([sourcePageId])
  // Inbound: "backlinks — what links HERE" + graph-edge queries.
  @@index([targetPageId])
}

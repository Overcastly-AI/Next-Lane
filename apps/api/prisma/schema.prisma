// Next Lane data model. Single source of truth for the database.
// Changes go through `prisma migrate`. See docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IssueType {
  TASK
  BUG
  STORY
  EPIC
  SUBTASK
}

enum Priority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
}

enum StatusCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum SprintState {
  PLANNED
  ACTIVE
  COMPLETED
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

enum NotificationType {
  ASSIGNED
  MENTIONED
  COMMENTED
  WATCHED_UPDATED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarColor  String   @default("#6366f1")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    Membership[]
  reportedIssues Issue[]       @relation("reporter")
  assignedIssues Issue[]       @relation("assignee")
  comments       Comment[]
  activities     ActivityLog[]
  watching       Watcher[]

  // Notifications addressed to this user (recipient) and ones this user caused.
  notifications      Notification[]      @relation("recipient")
  actedNotifications Notification[]      @relation("actor")
  passwordResetTokens PasswordResetToken[]
  apiTokens           ApiToken[]
  attachments         Attachment[]
  auditEvents         AuditEvent[]
}

// Personal API Token (PAT) for scripting / CI access to the REST API.
// Only the SHA-256 hex hash of the raw token is stored — the raw value
// is shown once at creation and never retrievable again.
// Token format on creation: "nlp_" + 32 random bytes base64url.
model ApiToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenHash   String    @unique // SHA-256 hex of the raw "nlp_..." token
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime? // null = active; non-null = revoked

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use time-limited token for password reset.
// Only the SHA-256 hash of the raw token is stored — the raw token is never
// persisted and only travels through the delivery channel (log in dev / SMTP later).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 hex of the raw 32-byte token
  expiresAt DateTime
  usedAt    DateTime? // null = not yet consumed

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  projects     Project[]
  auditEvents  AuditEvent[]
}

model Membership {
  id          String   @id @default(cuid())
  role        Role     @default(MEMBER)
  userId      String
  workspaceId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Project {
  id          String   @id @default(cuid())
  key         String // e.g. "NL"; unique within a workspace
  name        String
  description String?
  leadId      String?
  workspaceId String
  archived    Boolean  @default(false)
  issueSeq    Int      @default(0) // last issue number assigned for this project
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues    Issue[]
  statuses  Status[]
  sprints   Sprint[]
  labels    Label[]
  webhooks  WebhookSubscription[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model Status {
  id        String         @id @default(cuid())
  name      String
  category  StatusCategory @default(TODO)
  order     Int            @default(0)
  projectId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
}

model Sprint {
  id        String      @id @default(cuid())
  name      String
  goal      String?
  state     SprintState @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  projectId String
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
}

model Label {
  id        String @id @default(cuid())
  name      String
  color     String @default("#94a3b8")
  projectId String

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueLabel[]

  @@unique([projectId, name])
  @@index([projectId])
}

model Issue {
  id          String    @id @default(cuid())
  number      Int // per-project sequential number; key = project.key + "-" + number
  projectId   String
  type        IssueType @default(TASK)
  title       String
  description String?
  statusId    String
  assigneeId  String?
  reporterId  String?
  priority    Priority  @default(MEDIUM)
  storyPoints Int?
  parentId    String? // self-relation for epic -> story -> subtask
  sprintId    String?
  rank        String // fractional index for board/backlog ordering
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status     Status        @relation(fields: [statusId], references: [id])
  assignee   User?         @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter   User?         @relation("reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  parent     Issue?        @relation("subtasks", fields: [parentId], references: [id], onDelete: SetNull)
  children   Issue[]       @relation("subtasks")
  sprint     Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  comments    Comment[]
  activities  ActivityLog[]
  labels      IssueLabel[]
  watchers    Watcher[]
  notifications Notification[]
  attachments Attachment[]

  @@unique([projectId, number])
  @@index([projectId, statusId])
  @@index([statusId, rank])
  @@index([sprintId])
  @@index([assigneeId])
  @@index([parentId])
  // Covers keyset cursor pagination: WHERE projectId=X ORDER BY createdAt, id
  @@index([projectId, createdAt, id])
}

model IssueLabel {
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  issueId   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  issueId   String
  actorId   String
  field     String // e.g. "status", "assignee", "created"
  from      String?
  to        String?
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model Watcher {
  issueId String
  userId  String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
  @@index([userId])
}

// A per-recipient inbox item. Carries denormalized snapshot fields (issueKey,
// projectId, message) so the notification bell renders without N+1 lookups even
// if the source issue/comment later changes or is deleted.
model Notification {
  id        String           @id @default(cuid())
  userId    String // recipient
  type      NotificationType
  actorId   String? // who caused it (null if system / actor removed)
  issueId   String? // source issue (null if it was deleted)
  issueKey  String // e.g. "NL-12" — snapshot for rendering
  projectId String // for navigation to the right board
  message   String // short, pre-rendered summary line
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user  User  @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)
  issue Issue? @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
}

// A file attached to an issue. The raw file is stored on the local filesystem
// under UPLOADS_DIR (default ./uploads) by a UUID-based storageKey, so the
// client-supplied filename is never used as a path component. In K8s this
// directory maps to the `uploads` PVC provisioned by the Helm chart.
model Attachment {
  id         String   @id @default(cuid())
  issueId    String
  uploaderId String
  filename   String // original client-supplied name (display only, never used as path)
  mimeType   String
  sizeBytes  Int
  storageKey String   @unique // UUID-based filename on disk; never trust client filename
  createdAt  DateTime @default(now())

  issue    Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([uploaderId])
}

// Workspace-level audit log: immutable record of security- and
// governance-relevant actions (membership changes, project lifecycle,
// webhook config, API-token create/revoke, etc.).
// actorId is nullable so system-generated events can still be recorded.
model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String? // null = system / actor deleted
  action      String // e.g. "membership.add", "project.create", "token.revoke"
  targetType  String // e.g. "Membership", "Project", "ApiToken"
  targetId    String // the id of the affected resource
  metadata    Json?   // optional extra context (role, email, etc.)
  ip          String? // caller's IP, best-effort
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

// An outbound webhook endpoint registered by a project admin. When matching
// domain events occur (issue.*, comment.created, sprint.*), Next Lane POSTs the
// event payload to `url` with an HMAC-SHA256 signature derived from `secret`.
// `events` holds the subscribed event-type strings (e.g. "issue.created"); an
// empty array means "all" events.
model WebhookSubscription {
  id        String   @id @default(cuid())
  projectId String
  url       String
  secret    String // HMAC signing secret (shared with the receiver)
  events    String[] // subscribed event types; empty = all events
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([projectId])
}

// A log entry for a single attempted webhook delivery. Kept for the admin's
// recent-deliveries view; old rows are pruned to a bounded count per
// subscription. `status` is "success" or "failed".
model WebhookDelivery {
  id             String   @id @default(cuid())
  subscriptionId String
  event          String
  status         String // "success" | "failed"
  responseStatus Int? // HTTP status from the receiver, if any
  error          String? // failure detail (timeout, non-2xx, network error)
  createdAt      DateTime @default(now())

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
}

    "jira-alternative",
    "self-hosted",
    "next-lane"
  ],
  "homepage": "https://github.com/Overcastly-AI/Next-Lane/tree/main/apps/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Overcastly-AI/Next-Lane.git",
    "directory": "apps/mcp"
  },
  "bugs": {
    "url": "https://github.com/Overcastly-AI/Next-Lane/issues"
  },
  "author": "Overcastly AI (https://overcastly.com)",
  "type": "commonjs",
  "main": "./dist/index.js",
  "bin": {
